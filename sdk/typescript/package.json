{
  "name": "@intelliger/oati",
  "version": "0.1.0-dev.0",
  "description": "TypeScript models and validation helpers for OATI core, Commerce, and RWA profiles",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node scripts/smoke.mjs && node scripts/validate-schemas.mjs",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  }
}
