{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.intelliger.ai/oati/v1/well-known.schema.json",
  "title": "OATI Federation Well-Known Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["oati_version", "organisations", "resolvers"],
  "properties": {
    "oati_version": { "const": "1.0" },
    "organisations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^oati:org:[A-Za-z0-9._:-]+$" } },
    "resolvers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
