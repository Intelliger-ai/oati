{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.intelliger.ai/oati/v1/mandate.schema.json",
  "title": "OATI Agent Mandate",
  "type": "object",
  "additionalProperties": false,
  "required": ["oati_version", "id", "issuer", "subject", "purpose", "actions", "not_before", "expires_at", "status"],
  "properties": {
    "oati_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^oati:mandate:[A-Za-z0-9._:-]+$" },
    "issuer": { "type": "string" },
    "subject": { "type": "string", "pattern": "^oati:agent:[A-Za-z0-9._:-]+$" },
    "sponsor": { "type": "string" },
    "parent_mandate": { "type": "string" },
    "purpose": { "type": "string", "minLength": 1 },
    "actions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "resources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "counterparties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "destinations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "limits": { "type": "object", "additionalProperties": true },
    "data_use": { "type": "object", "additionalProperties": true },
    "delegation": {
      "type": "object",
      "properties": {
        "allowed": { "type": "boolean" },
        "max_depth": { "type": "integer", "minimum": 0 }
      }
    },
    "not_before": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "suspended", "revoked", "expired", "consumed"] },
    "proof": { "type": "object" }
  }
}
